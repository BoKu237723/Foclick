{
    "manifest_version": 3,
    "name": "Foclick",
    "version": "2.0.0",
    "description": "Going directly to target website's search to prevent forgetting main task by first post",
    "permissions": [
        "storage"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "96": "icon96.png"
        }
    },
    "background": {
        "service_worker": "background.js"
    },
    "options_page": "options.html",

    "icons": {
        "96": "icon96.png"
    },
    "commands": {
        "_execute_action": {
            "suggested_key": {
                "default": "Ctrl+Shift+F"
            },
            "description": "Open Foclick"
        }
    }
}