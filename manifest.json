{
    "manifest_version": 2,
    "name": "Foclick",
    "version": "2.0.2",
    "description": "Going directly to target website's search to prevent forgetting main task by first post",
    "permissions": [
        "storage"
    ],
    "browser_action": {
        "default_popup": "popup.html",
        "default_icon": {
            "96": "icon96.png"
        }
    },
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "options_ui": {
        "page": "options.html",
        "open_in_tab": true
    },
    "icons": {
        "96": "icon96.png"
    },
    "commands": {
        "_execute_browser_action": {
            "suggested_key": {
                "default": "Ctrl+F1"
            },
            "description": "Open Foclick"
        }
    },
    "browser_specific_settings": {
    "gecko": {
        "data_collection_permissions": {
            "required": ["none"]
        }
    }
}
}